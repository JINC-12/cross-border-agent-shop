# =====================================================================
# 环境变量模板文件
# 用法：复制本项目根目录下的 .env.example 为 .env，然后按需填写真实值。
#       Git Bash:  cp .env.example .env
#       PowerShell: Copy-Item .env.example .env
# 注意：.env 已被 .gitignore 忽略，禁止把真实密钥提交到仓库。
# =====================================================================

# ---------- 应用基础配置 ----------
APP_NAME=cross-border-agent-shop
APP_ENV=dev
DEBUG=true

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 大模型配置（阶段2才会真正用到） ----------
# 如果使用官方 OpenAI，只填 OPENAI_API_KEY 即可
# 如果使用兼容 OpenAI 协议的第三方服务，同时修改 OPENAI_BASE_URL 和 OPENAI_MODEL
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- MySQL 配置（阶段1暂不连接，先预留） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cross_border_shop
MYSQL_CHARSET=utf8mb4

# ---------- Redis 配置（阶段1暂不连接，先预留） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
